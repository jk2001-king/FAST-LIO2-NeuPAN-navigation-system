<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="end_feature_sparse_mid_world">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <model name="corridor_left_wall">
      <static>true</static>
      <pose>-21.0 2.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>30.0 0.1 2.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>30.0 0.1 2.0</size></box></geometry><material><script><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>

    <model name="corridor_right_wall">
